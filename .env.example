# ==============================================================================
# RakshakOS — Environment Configuration Example
# ==============================================================================
# Copy this file to .env and configure your environment.
# Never commit actual secret keys or .env files to source control.

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Threat Intelligence & External Security APIs (Optional)
# If left blank, the system automatically uses robust local ML models and heuristics.
VT_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=
URLSCAN_API_KEY=
GROQ_API_KEY=

# Model & Engine Paths
PHISHNET_MODEL_PATH=../Desktop/PhishNet/model.pkl
PHISHNET_FEATURES_PATH=../Desktop/PhishNet/features.pkl

# Security & Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
SESSION_SECRET=rakshakos_research_session_secret_change_in_prod
